table inet phishshield {
    set special_v4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
                     169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
                     192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
                     203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
    }
    set attached_v4 { type ipv4_addr; flags interval; }
    chain output {
        type filter hook output priority -150; policy drop;
        ct direction reply ct state established accept
        ip daddr 127.0.0.11 udp dport 53 accept
        ip daddr 127.0.0.11 tcp dport 53 accept
        ip daddr @special_v4 counter reject
        ip daddr @attached_v4 counter reject
        meta nfproto ipv4 tcp dport { 80, 443 } accept
        counter reject
    }
}
